# MongoDB Atlas: database personal-rag, collection knowledges, vector index vector_index (384 dims, cosine)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/personal-rag

# Groq answers the questions (free tier, console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI: embeddings (bge-small-en-v1.5) and the fallback LLM
# Account ID: any domain's Overview page. Token: My Profile → API Tokens → Custom token, permission Workers AI: Read
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Required for the /api/knowledge endpoints; leave empty to keep them disabled
ADMIN_TOKEN=

# Shared key the site sends as x-chat-key (same value as NEXT_PUBLIC_CHAT_API_KEY on the site).
# It ships in the site's public bundle, so it deters scanners rather than keeping a secret. Empty = chat routes open.
CHAT_API_KEY=

# App
PORT=3000
OWNER_NAME=Sidharth Singh
OWNER_EMAIL=sidharthsingh7111@gmail.com
SITE_URL=https://sidharthsingh.dev
ALLOWED_ORIGINS=https://sidharthsingh.dev,https://www.sidharthsingh.dev,http://localhost:3000,http://localhost:3111

# Retrieval and limits (defaults shown)
RAG_TOP_K=6
RAG_MIN_SCORE=0.78
RAG_MAX_TOKENS=600
CHAT_PER_MINUTE=8
CHAT_PER_DAY=60
CHAT_GLOBAL_PER_DAY=600
